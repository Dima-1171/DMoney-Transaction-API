    {
      "name": "verify OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();\r",
              "\r",
              "\r",
              "if (pm.response.code === 200) {\r",
              "\r",
              "    pm.test(\"Verify OTP - Status is 200\", function () {\r",
              "        pm.response.to.have.status(200);\r",
              "    });\r",
              "\r",
              "    pm.test(\"Verify OTP - Login successful message\", function () {\r",
              "        pm.expect(res.message).to.eql(\"Login successful\");\r",
              "    });\r",
              "\r",
              "    pm.test(\"Verify OTP - Role is Agent\", function () {\r",
              "        pm.expect(res.role).to.eql(\"Agent\");\r",
              "    });\r",
              "\r",
              "    pm.collectionVariables.set(\"Agent_token\", res.token);\r",
              "\r",
              "} else if (pm.response.code === 401) {\r",
              "\r",
              "    pm.test(\"Verify OTP - Status is 401\", function () {\r",
              "        pm.response.to.have.status(401);\r",
              "    });\r",
              "\r",
              "    pm.test(\"Verify OTP - OTP expired message\", function () {\r",
