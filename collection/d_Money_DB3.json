    {
      "name": "create Customer 01",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let res = pm.response.json();\r",
              "\r",
              "if (pm.response.code === 201) {\r",
              "\r",
              "    pm.test(\"User is created successfully\", function () {\r",
              "        pm.expect(res.message).to.eql(\"User created\");\r",
              "    });\r",
              "\r",
              "    pm.test(\"User status is pending\", function () {\r",
              "        pm.expect(res.user.status).to.eql(\"pending\");\r",
              "    });\r",
              "\r",
              "} else if (pm.response.code === 208) {\r",
              "\r",
              "    pm.test(\"User already exists message is shown\", function () {\r",
              "        pm.expect(res.message).to.eql(\"User already exists\");\r",
              "    });\r",
              "    } else if (pm.response.code === 403) {\r",
              "        pm.test(\"Verify Token Expired\",()=>{\r",
              "        pm.expect(res.message).to.eql(\"Token expired!\");\r",
              "    });\r",
              "\r",
              "}\r",
              "\r",
              "//customer id generate\r",
              "const userId=res.user.id;\r",
              "\r",
              "pm.collectionVariables.set(\"customer_01_id\", userId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const lodash=require('lodash');\r",
